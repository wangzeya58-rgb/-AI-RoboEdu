# AI RoboEdu local development environment
# Copy this file to .env.local or export variables in your shell.
# Never commit real passwords, production database URLs, or production session secrets.

# PostgreSQL development database.
# Recommended local version: PostgreSQL 15 or 16.
# Replace the placeholder password/database names for your local dev instance only.
DATABASE_URL=postgres://ai_roboedu_dev:change-me-local-only@localhost:5432/ai_roboedu_dev

# Server-side signed session secret.
# Use a unique value with at least 32 characters for local testing.
AUTH_SESSION_SECRET=replace-with-a-local-dev-secret-at-least-32-characters

# Demo login is for local/demo compatibility only.
# Keep this disabled in production.
ENABLE_DEMO_AUTH=true

# Persistent attachments, outside the repository/build. In development, leaving
# this unset uses ~/.local/share/ai-roboedu/course-files. Production MUST set it.
# COURSE_FILE_STORAGE_DIR=/var/lib/ai-roboedu/course-files
COURSE_UPLOAD_MAX_BYTES=52428800
# Public origin behind the reverse proxy; use your HTTPS origin in production.
APP_ORIGIN=http://127.0.0.1:5000
BIND_HOST=127.0.0.1

# AI Classroom provider.
# local keeps development runnable without external network or API keys.
# Set AI_CLASSROOM_PROVIDER=openai-compatible to call an OpenAI-compatible Chat Completions API.
AI_CLASSROOM_PROVIDER=local
AI_CLASSROOM_BASE_URL=https://api.openai.com/v1
AI_CLASSROOM_MODEL=gpt-4o-mini
AI_CLASSROOM_API_KEY=replace-with-provider-api-key
AI_CLASSROOM_TIMEOUT_MS=30000

# Robot tool layer. This is the FastAPI control host, not a direct ROS connection.
ROBOT_TOOL_BASE_URL=http://127.0.0.1:8000

# Optional bootstrap admin values for local development.
# These are consumed by `pnpm run db:seed-admin`.
BOOTSTRAP_ADMIN_USERNAME=admin.local
# Generate a unique password (16+ characters, uppercase/lowercase/digits).
# BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Local Admin
