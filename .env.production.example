# Template only: fill secrets on the server; never commit actual values.
NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=5000
APP_ORIGIN=https://edu.example.com
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@DATABASE_HOST:5432/APP_DATABASE
AUTH_SESSION_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENABLE_DEMO_AUTH=false
COURSE_FILE_STORAGE_DIR=/var/lib/ai-roboedu/course-files
COURSE_UPLOAD_MAX_BYTES=52428800
AI_CLASSROOM_PROVIDER=local
# Set provider/model/key explicitly to enable real AI. local is not a real LLM.
# AI_CLASSROOM_PROVIDER=openai-compatible
# AI_CLASSROOM_BASE_URL=https://YOUR_PROVIDER/v1
# AI_CLASSROOM_MODEL=YOUR_MODEL
# AI_CLASSROOM_API_KEY=
AI_CLASSROOM_TIMEOUT_MS=30000
